# Build the platform bitstream (Vivado 2024.2)
#   vivado -mode batch -source scripts/build_hw.tcl
set here [file normalize [file dirname [info script]]]
set root [file normalize "$here/.."]
set proj "$root/hw/accel.xpr"

open_project $proj

# The PCIe user-clock (userclk1, 250 MHz) paths inside the Xilinx PCIe IP are
# marginal with the default strategy: use the post-route phys_opt strategy.
set_property strategy {Performance_Explore} [get_runs impl_1]

# BD is an out-of-context BlockSrcs source: build it first, then the wrapper.
reset_run top_synth_1
launch_runs top_synth_1 -jobs 8
wait_on_run top_synth_1
puts "RUN top_synth_1: [get_property STATUS [get_runs top_synth_1]]"
if {[get_property PROGRESS [get_runs top_synth_1]] ne "100%"} {
    error "run top_synth_1 failed: [get_property STATUS [get_runs top_synth_1]]"
}

# After a clean build (accel.gen deleted) the BD wrapper is regenerated by the
# out-of-context run, so the file list has to be refreshed before synth_1.
# Note: add_files cannot parse paths with spaces, hence the relative path.
cd $root/hw
set wrap accel.gen/sources_1/bd/top/hdl/top_wrapper.v
if {[file exists $wrap] && [llength [get_files -quiet -of_objects [get_filesets sources_1] $wrap]] == 0} {
    add_files -norecurse -fileset sources_1 $wrap
    puts "added $wrap"
}
set_property top top_wrapper [get_filesets sources_1]
update_compile_order -fileset sources_1
update_compile_order -fileset sim_1

reset_run synth_1
launch_runs synth_1 -jobs 8
wait_on_run synth_1
puts "RUN synth_1: [get_property STATUS [get_runs synth_1]]"
if {[get_property PROGRESS [get_runs synth_1]] ne "100%"} {
    error "run synth_1 failed: [get_property STATUS [get_runs synth_1]]"
}

reset_run impl_1
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
set st [get_property STATUS [get_runs impl_1]]
puts "RUN impl_1: $st ([get_property PROGRESS [get_runs impl_1]])"
if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} { error "impl_1 failed: $st" }

set wns [get_property STATS.WNS [get_runs impl_1]]
set tns [get_property STATS.TNS [get_runs impl_1]]
puts "TIMING: WNS=$wns ns  TNS=$tns ns"
if {$wns < 0} {
    error "timing not met: WNS=$wns ns (see top_wrapper_timing_summary_routed.rpt)"
}

set bit "$root/hw/accel.runs/impl_1/top_wrapper.bit"
puts "BITSTREAM: $bit  ([expr {[file size $bit]/1048576}] MB)"
